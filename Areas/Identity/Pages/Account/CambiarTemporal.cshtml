@page
@using static Logistica_y_transporte.Localizacion.Interfaz
@model CambiarTemporalModel
@{Layout="/Views/Shared/_AuthLayout.cshtml";ViewData["Title"]=T("Define tu contraseña definitiva","Set your permanent password");}
<h1>@ViewData["Title"]</h1><p>@T("Cambia tu contraseña temporal antes de continuar. Después configura tu autenticador para acceder a Personas.","Change your temporary password before continuing. Then set up your authenticator to access People.")</p>
<form method="post"><div asp-validation-summary="All" role="alert"></div><label asp-for="Input.Actual">@T("Contraseña temporal","Temporary password")</label><input asp-for="Input.Actual" autocomplete="current-password" class="form-control"/><label asp-for="Input.Nueva">@T("Contraseña nueva","New password")</label><input asp-for="Input.Nueva" autocomplete="new-password" class="form-control" data-dc-password-rules/><ul data-dc-rules="Input_Nueva" aria-live="polite">@foreach(var rule in new[]{("number",T("Un número","One number")),("upper",T("Una mayúscula","One uppercase letter")),("lower",T("Una minúscula","One lowercase letter")),("symbol",T("Un símbolo","One symbol")),("length",T("Mínimo 8 caracteres","At least 8 characters"))}){<li data-rule="@rule.Item1"><span data-rule-icon>○</span> @rule.Item2 <span data-rule-status class="visually-hidden"></span></li>}</ul><label asp-for="Input.Confirmacion">@T("Confirmar contraseña","Confirm password")</label><input asp-for="Input.Confirmacion" autocomplete="new-password" class="form-control"/><button class="dc-primary" type="submit">@T("Guardar e iniciar sesión otra vez","Save and sign in again")</button></form><form asp-page="./Logout" method="post"><button type="submit">@T("Cerrar sesión","Sign out")</button></form>
