@page
@model LoginModel
@using static Logistica_y_transporte.Localizacion.Interfaz
@{
 Layout="/Views/Shared/_AuthLayout.cshtml";ViewData["Title"]=T("Iniciar sesión","Sign in");}
<section class="corp-card"><h1>@ViewData["Title"]</h1><p>@T("Accede con tu cuenta autorizada.","Use your authorized account.")</p>
<form method="post" asp-route-returnUrl="@Model.ReturnUrl"><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<div class="mb-3"><label asp-for="Input.Email">@T("Correo electrónico","Email")</label><input asp-for="Input.Email" class="form-control" autocomplete="username" required/><span asp-validation-for="Input.Email" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Input.Password">@T("Contraseña","Password")</label><input asp-for="Input.Password" class="form-control" autocomplete="current-password" required/><span asp-validation-for="Input.Password" class="text-danger"></span></div>
<label><input asp-for="Input.RememberMe"/> @T("Recordarme","Remember me")</label><p><button class="dc-primary" type="submit">@T("Iniciar sesión","Sign in")</button></p>
<a asp-page="./ForgotPassword">@T("¿Olvidaste tu contraseña?","Forgot your password?")</a> · <a asp-page="./Register">@T("Crear cuenta","Create account")</a></form><p><a asp-page="./Manage/TwoFactorAuthentication">@T("Configurar verificación en dos pasos (2FA)","Set up two-step verification (2FA)")</a></p><p>@T("Si ya activaste 2FA, se solicitará el código después de tu contraseña.","If you enabled 2FA, your code will be requested after your password.")</p></section>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
