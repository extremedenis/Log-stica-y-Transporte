@page
@using static Logistica_y_transporte.Localizacion.Interfaz
@model LoginWithRecoveryCodeModel
@{
 Layout="/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = T("Verificación con código de recuperación","Recovery code verification");
}

<h1>@ViewData["Title"]</h1>
<hr />
<p>@T("Solicitaste entrar con un código de recuperación. Este acceso no se recordará hasta que proporciones un código de la aplicación autenticadora o desactives el segundo factor y vuelvas a entrar.","You have requested to log in with a recovery code. This login will not be remembered until you provide an authenticator app code at log in or disable 2FA and log in again.")</p>
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" placeholder="RecoveryCode" />
                <label asp-for="Input.RecoveryCode" class="form-label">@T("Código de recuperación","Recovery code")</label>
                <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">@T("Iniciar sesión","Log in")</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}