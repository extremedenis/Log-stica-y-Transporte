@page
@using static Logistica_y_transporte.Localizacion.Interfaz
@model LogoutModel
@{
    ViewData["Title"] = T("Cerrar sesión","Log out");
}

<header>
    <h1>@ViewData["Title"]</h1>
    @{
        if (User.Identity?.IsAuthenticated ?? false)
        {
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                <button type="submit" class="nav-link btn btn-link text-dark">@T("Haz clic para cerrar sesión","Click here to Logout")</button>
            </form>
        }
        else
        {
            <p>@T("Cerraste la sesión de la aplicación.","You have successfully logged out of the application.")</p>
        }
    }
</header>
