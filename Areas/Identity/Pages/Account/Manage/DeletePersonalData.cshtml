@page
@using static Logistica_y_transporte.Localizacion.Interfaz
@model DeletePersonalDataModel
@{
    ViewData["Title"]=T("Eliminar datos personales","Delete Personal Data");
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3>@ViewData["Title"]</h3>

<div class="alert alert-warning" role="alert">
    <p>
        <strong>@T("Eliminar estos datos borrará tu cuenta permanentemente y no podrás recuperarla.","Deleting this data will permanently remove your account, and this cannot be recovered.")</strong>
    </p>
</div>

<div>
    <form id="delete-user" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        @if (Model.RequirePassword)
        {
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Please enter your password." />
                <label asp-for="Input.Password" class="form-label">@T("Contraseña","Password")</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
        }
        <button class="w-100 btn btn-lg btn-danger" type="submit">@T("Eliminar datos y cerrar mi cuenta","Delete data and close my account")</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
