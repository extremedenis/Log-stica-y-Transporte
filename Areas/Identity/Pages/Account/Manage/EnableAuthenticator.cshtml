@page
@using static Logistica_y_transporte.Localizacion.Interfaz
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Configure authenticator app";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div>
    <p>@T("Para usar una aplicación autenticadora, sigue estos pasos:","To use an authenticator app go through the following steps:")</p>
    <ol class="list">
        <li>
            <p>@T("Descarga una aplicación como Microsoft Authenticator para","Download a two-factor authenticator app like Microsoft Authenticator for")<a href="https://go.microsoft.com/fwlink/?Linkid=825072">Android</a>@T("y","and")<a href="https://go.microsoft.com/fwlink/?Linkid=825073">iOS</a>@T("o Google Authenticator para","or Google Authenticator for")<a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=en">Android</a>@T("y","and")<a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8">iOS</a>.
            </p>
        </li>
        <li>
            <p>@T("Escanea el código QR o escribe esta clave","Scan the QR Code or enter this key")<kbd>@Model.SharedKey</kbd>@T("en tu aplicación autenticadora. Los espacios y mayúsculas no afectan la clave.","into your two factor authenticator app. Spaces and casing do not matter.")</p>
            <div class="alert alert-info">@T("Aprende a","Learn how to")<a href="https://go.microsoft.com/fwlink/?Linkid=852423">@T("habilitar la generación del código QR","enable QR code generation")</a>.</div>
            <div id="qrCode"></div>
            <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
        </li>
        <li>
            <p>@T("Después de escanear el código QR o escribir la clave, la aplicación autenticadora te dará un código. Escríbelo en el campo de confirmación.","Once you have scanned the QR code or input the key above, your two factor authentication app will provide you with a unique code. Enter the code in the confirmation box below.")</p>
            <div class="row">
                <div class="col-md-6">
                    <form id="send-code" method="post">
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Code" class="form-control" autocomplete="off" placeholder="Please enter the code."/>
                            <label asp-for="Input.Code" class="control-label form-label">@T("Código de verificación","Verification Code")</label>
                            <span asp-validation-for="Input.Code" class="text-danger"></span>
                        </div>
                        <button type="submit" class="w-100 btn btn-lg btn-primary">@T("Verificar","Verify")</button>
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    </form>
                </div>
            </div>
        </li>
    </ol>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
