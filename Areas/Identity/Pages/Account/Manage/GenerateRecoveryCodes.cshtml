@page
@using static Logistica_y_transporte.Localizacion.Interfaz
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "Generate two-factor authentication (2FA) recovery codes";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>@T("Guarda estos códigos en un lugar seguro.","Put these codes in a safe place.")</strong>
    </p>
    <p>@T("Si pierdes tu dispositivo y no tienes códigos de recuperación, perderás el acceso a tu cuenta.","If you lose your device and don't have the recovery codes you will lose access to your account.")</p>
    <p>@T("Generar códigos de recuperación no cambia las claves del autenticador. Para cambiarlas debes","Generating new recovery codes does not change the keys used in authenticator apps. If you wish to change the key used in an authenticator app you should")<a asp-page="./ResetAuthenticator">@T("restablecer las claves de tu autenticador.","reset your authenticator keys.")</a>
    </p>
</div>
<div>
    <form method="post">
        <button class="btn btn-danger" type="submit">@T("Generar códigos de recuperación","Generate Recovery Codes")</button>
    </form>
</div>
