@page
@using static Logistica_y_transporte.Localizacion.Interfaz
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = T("Restablecer clave del autenticador","Reset authenticator key");
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>@T("Si restableces la clave del autenticador, la aplicación dejará de funcionar hasta que la configures de nuevo.","If you reset your authenticator key your authenticator app will not work until you reconfigure it.")</strong>
    </p>
    <p>@T("Este proceso desactiva el segundo factor hasta verificar la aplicación. Si no completas la configuración, podrías perder acceso a tu cuenta.","This process disables 2FA until you verify your authenticator app. If you do not complete your authenticator app configuration you may lose access to your account.")</p>
</div>
<div>
    <form id="reset-authenticator-form" method="post">
        <button id="reset-authenticator-button" class="btn btn-danger" type="submit">@T("Restablecer clave del autenticador","Reset authenticator key")</button>
    </form>
</div>
