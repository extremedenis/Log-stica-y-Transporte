@page
@using static Logistica_y_transporte.Localizacion.Interfaz
@model RegisterModel
@{
 Layout="/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = T("Crear cuenta","Register");
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-4">
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">

            <hr />
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email">@T("Correo electrónico","Email")</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true"  />
                <label asp-for="Input.Password">@T("Contraseña","Password")</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <partial name="_PasswordRequirements" model='"Input_Password"'/>
            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.ConfirmPassword">@T("Confirmar contraseña","Confirm Password")</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">@T("Crear cuenta","Register")</button>
        </form>
    </div>
</div>

@if(Model.ExternalLogins?.Count>0){<form asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">@foreach(var provider in Model.ExternalLogins){<button type="submit" class="btn btn-primary" name="provider" value="@provider.Name">@provider.DisplayName</button>}</form>}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
