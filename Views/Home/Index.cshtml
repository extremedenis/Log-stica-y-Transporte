@using static Logistica_y_transporte.Localizacion.Interfaz
@{ViewData["Title"]=T("Inicio","Home");}
<p>DENIS CORP · @T("LOGÍSTICA Y TRANSPORTE","LOGISTICS AND TRANSPORT")</p><h1>@T("Organiza los contactos de tu operación.","Organize your operation's contacts.")</h1><p>@T("Accede a los registros de personas según los permisos de tu cuenta. Las funciones de envíos, rutas y métricas operativas están en preparación.","Access person records according to your account permissions. Shipments, routes and operational metrics are in preparation.")</p>
<div class="corp-grid"><article class="corp-card"><h2>@T("Directorio de personas","People directory")</h2><p>@T("Consulta y administra los registros autorizados. El acceso y las acciones disponibles dependen de tus permisos.","View and manage authorized records. Access and available actions depend on your permissions.")</p><a class="btn" asp-controller="Personas" asp-action="Index">@T("Abrir directorio","Open directory")</a></article><article class="corp-card"><h2>@T("Protege tu cuenta","Protect your account")</h2><p>@T("Configura la aplicación autenticadora y conserva tus códigos de recuperación en un lugar seguro.","Set up an authenticator app and keep your recovery codes in a safe place.")</p><a class="btn" asp-area="Identity" asp-page="/Account/Manage/TwoFactorAuthentication">@T("Configurar segundo factor","Set up two-factor authentication")</a></article><article class="corp-card"><h2>@T("Guías del programa","Program guides")</h2><p>@T("Conoce las funciones disponibles y sus límites antes de comenzar.","Learn about available features and their limitations before getting started.")</p><a class="btn" asp-action="Blog">@T("Leer las guías","Read the guides")</a></article></div>

@if(User.Identity?.IsAuthenticated!=true){<p><a class="btn" asp-area="Identity" asp-page="/Account/Login">@T("Ingresar a Logística", "Sign in to Logistics")</a></p>}
