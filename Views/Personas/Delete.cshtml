@using static Logistica_y_transporte.Localizacion.Interfaz
@model Logistica_y_transporte.Models.Persona

@{
    ViewData["Title"] = T("Eliminar","Delete");
}

<h1>@T("Eliminar","Delete")</h1>

<h3>@T("¿Seguro que deseas eliminar este registro?","Are you sure you want to delete this?")</h3>
<div>
    <h4>@T("Persona","Persona")</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @T("Nombres","First names")
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>
        <dt class = "col-sm-2">
            @T("Apellidos","Last names")
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Apellido)
        </dd>
        <dt class = "col-sm-2">
            @T("Dirección","Address")
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Direccion)
        </dd>
        <dt class = "col-sm-2">
            @T("Cuenta vinculada","Linked account")
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.User.Id)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="personaId" />
        <input type="submit" value="@T("Eliminar","Delete")" class="btn btn-danger" /> |
        <a asp-action="Index">@T("Volver al directorio","Back to List")</a>
    </form>
</div>
