@using static Logistica_y_transporte.Localizacion.Interfaz
@model Logistica_y_transporte.Models.PersonaFormulario

@{
    ViewData["Title"] = T("Editar","Edit");
}

<h1>@T("Editar","Edit")</h1>

<h4>@T("Persona","Persona")</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="PersonaId" />
            <div class="form-group">
                <label asp-for="Nombre" class="control-label">@T("Nombres","First names")</label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Apellido" class="control-label">@T("Apellidos","Last names")</label>
                <input asp-for="Apellido" class="form-control" />
                <span asp-validation-for="Apellido" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Direccion" class="control-label">@T("Dirección","Address")</label>
                <input asp-for="Direccion" class="form-control" />
                <span asp-validation-for="Direccion" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="@T("Guardar","Save")" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">@T("Volver al directorio","Back to List")</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
