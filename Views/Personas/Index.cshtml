@using static Logistica_y_transporte.Localizacion.Interfaz
@model IEnumerable<Logistica_y_transporte.Models.Persona>

@{
    ViewData["Title"] = T("Directorio","Index");
}

<h1>@T("Directorio","Index")</h1>

<p>
    <a asp-action="Create">@T("Crear registro","Create New")</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @T("Nombres","First names")
            </th>
            <th>
                @T("Apellidos","Last names")
            </th>
            <th>
                @T("Dirección","Address")
            </th>
            <th>
                @T("Cuenta vinculada","Linked account")
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Apellido)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Direccion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.User.Id)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.personaId">@T("Editar","Edit")</a> |
                <a asp-action="Details" asp-route-id="@item.personaId">@T("Detalles","Details")</a> |
                <a asp-action="Delete" asp-route-id="@item.personaId">@T("Eliminar","Delete")</a>
            </td>
        </tr>
}
    </tbody>
</table>

               