@model ErrorViewModel
@using static Logistica_y_transporte.Localizacion.Interfaz
@{ViewData["Title"]=T("No se pudo completar la operación","The operation could not be completed");}
<h1>@ViewData["Title"]</h1><p>@T("Inténtalo de nuevo. Si continúa el problema, informa al responsable e indica el identificador de referencia.","Try again. If the problem continues, contact the operator and provide the reference ID.")</p>
@if(Model.ShowRequestId){<p>@T("Referencia:","Reference:") <code>@Model.RequestId</code></p>}
