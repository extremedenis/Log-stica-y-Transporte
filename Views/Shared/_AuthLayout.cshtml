@inject Microsoft.Extensions.Configuration.IConfiguration CorporateConfiguration
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment CorporateEnvironment
@using static Logistica_y_transporte.Localizacion.Interfaz
@{Layout=null;var page=ViewContext.RouteData.Values["page"]?.ToString()??"";}
<!DOCTYPE html><html lang="@Codigo" data-dc-product="logistica"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · Denis Corp Logística</title><link rel="icon" href="~/favicon.ico"/><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><script src="~/js/preferences.js" asp-append-version="true"></script><link rel="stylesheet" href="~/css/denis-ui.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/scroll-guide.css" asp-append-version="true"/></head><body class="dc-auth-page"><header class="dc-auth-header"><a class="dc-auth-brand" asp-area="" asp-controller="Home" asp-action="Index">Denis Corp.<small>@T("Logística","Logistics")</small></a><div class="dc-auth-controls"><form asp-area="" asp-controller="Home" asp-action="Idioma" method="post"><input type="hidden" name="volver" value="@(Context.Request.PathBase+Context.Request.Path+Context.Request.QueryString)"/><button class="language-toggle" type="submit" name="idioma" value="@(English?"es":"en")" aria-label="@T("Cambiar a inglés","Switch to Spanish")"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/></svg>@(English?"ES":"EN")</button></form><button type="button" id="theme-toggle" aria-label="@T("Cambiar modo día o noche","Switch light or dark mode")"><svg class="dc-icon-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z"/></svg><svg class="dc-icon-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1 1m12 12 1 1M5 19l1-1M18 6l1-1"/></svg></button><a class="dc-back" asp-area="" asp-controller="Home" asp-action="Index">@T("← Volver al inicio","← Back to home")</a></div></header><main class="dc-auth"><aside class="dc-auth-story"><span class="eyebrow">@T("CADA RUTA. BAJO CONTROL.","EVERY ROUTE. UNDER CONTROL.")</span><h2>@T("Tu próxima entrega empieza más organizada.","Your next delivery starts more organized.")</h2><p>@T("Organiza la operación y consulta la información de transporte desde un solo lugar.","Organize operations and access transport information in one place.")</p><div class="dc-auth-preview"><small>@T("Vista de ejemplo","Example view")</small><div class="dc-auth-preview-grid"><div><strong>@T("Personas","People")</strong><p>@T("Información autorizada.","Authorized information.")</p></div><div><strong>@T("Operación","Operations")</strong><p>@T("Seguimiento y organización.","Tracking and organization.")</p></div></div></div></aside><section class="dc-auth-panel"><div class="dc-auth-form">@if(page.EndsWith("/Login")||page.EndsWith("/Register")){<nav class="dc-auth-tabs"><a asp-page="/Account/Login" asp-route-returnUrl="@Context.Request.Query["returnUrl"]" aria-current="@(page.EndsWith("/Login")?"page":null)">@T("Iniciar sesión","Sign in")</a><a asp-page="/Account/Register" asp-route-returnUrl="@Context.Request.Query["returnUrl"]" aria-current="@(page.EndsWith("/Register")?"page":null)">@T("Crear cuenta","Create account")</a></nav>}@RenderBody()</div></section></main><footer class="dc-auth-footer"><a href="@Logistica_y_transporte.Seguridad.EnlacesCorporativos.Inicio(CorporateConfiguration,CorporateEnvironment)">by Denis Corp ↗</a></footer><script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/denis-ui.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)<script type="module" src="~/js/scroll-guide.js" asp-append-version="true"></script></body></html>