@using static Logistica_y_transporte.Localizacion.Interfaz
<!DOCTYPE html><html lang="@Codigo"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>@ViewData["Title"] · Denis Corp Logística</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
<link rel="stylesheet" href="~/css/scroll-guide.css" asp-append-version="true"/>
<script src="~/js/preferences.js" asp-append-version="true"></script></head>
<body><a class="skip-link" href="#main">@T("Saltar al contenido","Skip to content")</a>
<header class="corp-header"><a class="corp-brand" asp-area="" asp-controller="Home" asp-action="Index">Denis Corp<span>.</span><small>@T("Logística y transporte","Logistics and transport")</small></a>
<nav aria-label="@T("Navegación principal","Main navigation")"><a asp-area="" asp-controller="Home" asp-action="Index">@T("Inicio","Home")</a><a asp-area="" asp-controller="Home" asp-action="Blog">@T("Blog y guías","Blog and guides")</a><a asp-area="" asp-controller="Home" asp-action="Privacy">@T("Privacidad","Privacy")</a></nav>
<div class="corp-controls"><partial name="_LoginPartial"/><form asp-area="" asp-controller="Home" asp-action="Idioma" method="post"><input type="hidden" name="volver" value="@(Context.Request.PathBase+Context.Request.Path+Context.Request.QueryString)"/><button type="submit" name="idioma" value="@(English?"es":"en")" aria-label="@T("Cambiar a inglés","Switch to Spanish")">@(English?"ES":"EN")</button></form><button type="button" id="theme-toggle" aria-label="@T("Cambiar modo día o noche","Switch light or dark mode")"><span aria-hidden="true">☼ / ☾</span></button></div></header>
<div class="container"><main id="main" class="pb-3">@RenderBody()</main></div>
<footer class="corp-footer"><p>© @DateTime.UtcNow.Year Denis Corp. · @T("Logística y transporte","Logistics and transport") · v0.4.0</p><a asp-area="" asp-controller="Home" asp-action="Privacy">@T("Privacidad","Privacy")</a></footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script type="module" src="~/js/scroll-guide.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts",required:false)</body></html>
