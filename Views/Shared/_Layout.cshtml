@inject Microsoft.Extensions.Configuration.IConfiguration CorporateConfiguration
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment CorporateEnvironment
@using static Logistica_y_transporte.Localizacion.Interfaz
<!DOCTYPE html><html data-dc-product="logistica" lang="@Codigo"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>@ViewData["Title"] · Denis Corp Logística</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
<link rel="stylesheet" href="~/css/scroll-guide.css" asp-append-version="true"/>
<script src="~/js/preferences.js" asp-append-version="true"></script><link rel="stylesheet" href="~/css/denis-ui.css" asp-append-version="true"/></head>
<body><a class="skip-link" href="#main">@T("Saltar al contenido","Skip to content")</a>
<header class="corp-header"><a class="corp-brand" asp-area="" asp-controller="Home" asp-action="Index">Denis Corp<span>.</span><small>@T("Logística y transporte","Logistics and transport")</small></a>
<nav aria-label="@T("Navegación principal","Main navigation")"><a asp-area="" asp-controller="Home" asp-action="Index">@T("Inicio","Home")</a><a asp-area="" asp-controller="Home" asp-action="Blog">@T("Blog y guías","Blog and guides")</a><a asp-area="" asp-controller="Home" asp-action="Privacy">@T("Privacidad","Privacy")</a></nav>
<div class="corp-controls"><partial name="_LoginPartial"/><form asp-area="" asp-controller="Home" asp-action="Idioma" method="post"><input type="hidden" name="volver" value="@(Context.Request.PathBase+Context.Request.Path+Context.Request.QueryString)"/><button class="language-toggle" type="submit" name="idioma" value="@(English?"es":"en")" aria-label="@T("Cambiar a inglés","Switch to Spanish")"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/></svg>@(English?"ES":"EN")</button></form><button type="button" id="theme-toggle" aria-label="@T("Cambiar modo día o noche","Switch light or dark mode")"><svg class="dc-icon-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z"/></svg><svg class="dc-icon-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1 1m12 12 1 1M5 19l1-1M18 6l1-1"/></svg></button></div></header>
<div class="container"><main id="main" class="pb-3">@RenderBody()</main></div>
<footer class="corp-footer"><a class="corporate-home" data-corporate-home href="@Logistica_y_transporte.Seguridad.EnlacesCorporativos.Inicio(CorporateConfiguration,CorporateEnvironment)" aria-label="@T("Volver al inicio de Denis Corp","Return to Denis Corp home")">by Denis Corp ↗</a><p>© @DateTime.UtcNow.Year Denis Corp. · @T("Logística y transporte","Logistics and transport") · v@(typeof(Logistica_y_transporte.Models.AppDbContext).Assembly.GetName().Version?.ToString(3))</p><a asp-area="" asp-controller="Home" asp-action="Privacy">@T("Privacidad","Privacy")</a></footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script type="module" src="~/js/scroll-guide.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts",required:false)<script src="~/js/denis-ui.js" asp-append-version="true"></script></body></html>
