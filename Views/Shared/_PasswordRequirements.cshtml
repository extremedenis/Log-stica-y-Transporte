@model string
@using static Logistica_y_transporte.Localizacion.Interfaz
<ul class="dc-password-rules" data-dc-rules="@Model" aria-live="polite">@foreach(var rule in new[]{("number",T("Mínimo 1 número","At least 1 number")),("upper",T("Mínimo 1 letra mayúscula","At least 1 uppercase letter")),("lower",T("Mínimo 1 letra minúscula","At least 1 lowercase letter")),("symbol",T("Mínimo 1 símbolo","At least 1 symbol")),("length",T("Mínimo 8 caracteres","At least 8 characters"))}){<li data-rule="@rule.Item1"><span data-rule-icon aria-hidden="true">○</span> @rule.Item2 <span class="visually-hidden" data-rule-status>@T("Pendiente","Pending")</span></li>}</ul>