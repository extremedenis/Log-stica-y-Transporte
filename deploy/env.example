# Copy outside Git as .env.private, mode 0600. Replace EXAMPLE host and credentials privately.
ConnectionStrings__DefaultConnection=Host=postgres-private.example;Port=5432;Database=logistica;Username=logistica_app;Password=REPLACE;SSL Mode=VerifyFull;Timeout=5
AllowedHosts=logistica.zuni.lat
# Exact socket address of the trusted gateway, not a visitor or an entire network.
Hosting__KnownProxies__0=127.0.0.1
